<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="si5" translate="label" sortOrder="900">
            <label>SI5</label>
        </tab>
        <section id="si5global" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>SI5 Global</label>
            <tab>si5</tab>
            <resource>Si5_GlobalCatalog::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1">
                <label>API</label>
                <comment>Fills product name, brand, weight, picture, NCM and CEST from the barcode, always with a review in the product page before saving. Create an account and an API token at global.si5.com.br (the free plan has a daily lookup quota). Only the barcode and this token are sent to the API.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Show in the product page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="token" translate="label" type="obscure" sortOrder="20" showInDefault="1">
                    <label>API token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
